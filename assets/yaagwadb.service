[Unit]
Description=YaagwaDB daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/yaagwadb -c /etc/yaagwadb/config.toml daemon
User=yaagwadb
Group=yaagwadb
StateDirectory=yaagwadb
StateDirectoryMode=0700
RuntimeDirectory=yaagwadb
RuntimeDirectoryMode=0755
KillSignal=SIGTERM
TimeoutStopSec=1min
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
